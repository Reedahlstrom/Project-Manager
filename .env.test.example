# Integration test configuration. Copy to .env.test — which is gitignored.
#
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses row-level security completely.
# It exists here only so the tests can create fixtures that the policies are
# then asserted against. It must never appear in a VITE_ variable, in src/, or
# in a commit.

SUPABASE_URL=https://vgsfqcuhiliazgmjznje.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

TEST_REED_EMAIL=
TEST_REED_PASSWORD=
TEST_HEATHER_EMAIL=
TEST_HEATHER_PASSWORD=

# Supabase CLI access token. Avoids the macOS keychain, which can loop on the
# password prompt. Create one at supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
