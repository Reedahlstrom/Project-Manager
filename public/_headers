# Cloudflare Pages response headers.
#
# Cloudflare Access sits in front of all of this and is the real perimeter.
# These are defence in depth for the case where a session is already valid.
#
# The CSP is strict because the production build contains zero inline scripts —
# verified at build time. If a future dependency injects one, the app will break
# loudly in the console rather than silently weakening the policy. Fix the
# dependency; do not add 'unsafe-inline' to script-src.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://vgsfqcuhiliazgmjznje.supabase.co wss://vgsfqcuhiliazgmjznje.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive

# The shell must revalidate so a deploy is picked up rather than served stale
# from a previous session's cache.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# Hashed assets are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
