# Secrets — never commit. If a key lands in a commit, ROTATE it, don't just delete the line.
# Deny every .env by default and allow back only the templates, so a new
# .env.<something> can never be committed by accident. .env.test in particular
# holds the service role key, which bypasses RLS entirely.
.env*
!.env.example
!.env.test.example
*.pem

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Supabase local state
.supabase
supabase/.temp
supabase/.branches

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage
playwright-report
test-results

# Exports produced by the backup command (prompt 9)
exports/

# Local iPhone screenshots from scripts/mobile-shots.mjs
mobile-shots/
