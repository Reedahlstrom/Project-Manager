# Cadence — frontend environment.
#
# ONLY these two variables belong here. Anything prefixed VITE_ is compiled into
# the browser bundle and is readable by anyone who opens devtools.
#
# The service role key, the Anthropic key, and the Resend key are SERVER-ONLY.
# They live as Supabase Edge Function secrets. They must never appear in this
# file, in any VITE_ variable, or anywhere under src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
